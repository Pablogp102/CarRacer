<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.race.RaceFragment">

    <!-- Kontener (FrameLayout) działający jako przycisk "Race" -->
    <FrameLayout
        android:id="@+id/race_button_container"
        android:layout_width="400dp"
        android:layout_height="470dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="@drawable/race"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginBottom="0dp">

        <!-- ImageView dla tła/grafiki przycisku -->
        <ImageView
            android:id="@+id/race_button_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Race Button Image"
            android:scaleType="fitCenter"
            android:src="@drawable/race"
            app:tint="@null" />

    </FrameLayout>

    <!-- Tekst informacyjny o uprawnieniach (opcjonalnie, widoczny tylko gdy brak uprawnień) -->
    <TextView
        android:id="@+id/permission_info_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="Aplikacja wymaga uprawnień do lokalizacji, aby przeprowadzać pomiary. Kliknij przycisk, aby je przyznać."
        android:textColor="@android:color/holo_red_dark"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/race_button_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


